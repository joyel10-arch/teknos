# SafeWatch AI — .env.example
# Copy this file to .env in the project root and edit as needed.
# All values shown here are the defaults already in config.py.
# Do NOT commit .env to git (it is in .gitignore).

# ── Paths (relative to project root unless absolute) ──────────────────
VIDEOS_DIR=datasets/videos
ZONES_DIR=datasets/zones
GROUND_TRUTH_DIR=datasets/ground_truth
UPLOADS_DIR=backend/uploads
OUTPUTS_BASE=backend/outputs
TRACKS_CACHE_DIR=backend/outputs/tracks_cache
ANNOTATED_VIDEOS_DIR=backend/outputs/annotated_videos
EVIDENCE_FRAMES_DIR=backend/outputs/evidence_frames
REPORTS_DIR=backend/outputs/reports
DB_PATH=backend/outputs/safewatch.db

# ── Model / tracker ───────────────────────────────────────────────────
YOLO_MODEL=yolo11n.pt
YOLO_FALLBACK_MODEL=yolov8n.pt
YOLO_CONF=0.25
YOLO_IMGSZ=640
TRACKER_CONFIG=backend/configs/bytetrack_custom.yaml
DEVICE=cpu

# ── Track quality ─────────────────────────────────────────────────────
MIN_TRACK_SECONDS=1.0
MAX_GAP_SECONDS=1.0
SMOOTHING_WINDOW_SECONDS=0.4

# ── Zone engine ───────────────────────────────────────────────────────
ZONE_MIN_FRAMES=3

# ── Behaviour rules (thresholds at reference 640×360 px) ─────────────
MIN_WALK_SECONDS=1.5
RESTRICTED_REENTRY_COOLDOWN_SECONDS=2.0
COUNT_INITIAL_INSIDE_AS_ENTRY=false
LOITERING_DURATION_SECONDS=10.0
MOVEMENT_WINDOW_SECONDS=3.0
MAX_AVERAGE_SPEED_PX_PER_SECOND=8.0
MIN_DIRECTION_TRAVEL_PX=80.0

# ── Evidence confidence weights (must sum to 1.0) ─────────────────────
CONFIDENCE_W_DETECTION=0.45
CONFIDENCE_W_TRACK=0.30
CONFIDENCE_W_RULE=0.25
RESTRICTED_CONFIRM_FRAMES=10

# ── Video pipeline ────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=209715200
TRAJECTORY_TAIL_FRAMES=30
EVIDENCE_JPEG_QUALITY=90

# ── API ───────────────────────────────────────────────────────────────
APP_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:5173"]
API_PREFIX=/api
